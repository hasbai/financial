{
  "name": "tavern",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5176",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4176",
    "typecheck": "wrangler types worker-env.d.ts && svelte-check --tsconfig tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "visual:local": "node ../../scripts/visual-linux.mjs tavern",
    "check:visual-coverage": "node ../financial/scripts/check-visual-coverage.mjs",
    "visual:baseline:import": "node scripts/baselines.mjs import",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@hasbai/auth": "workspace:*",
    "@hasbai/ui": "workspace:*",
    "@lucide/svelte": "^1.45.0",
    "@tailwindcss/vite": "^4.3.3",
    "jose": "^6.1.0",
    "svelte": "^5.57.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^26.5.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "5.0.0",
    "wrangler": "^4.131.1"
  },
  "version": "0.1.0"
}
