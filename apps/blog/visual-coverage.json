{
  "inventory": {
    "root": "src/routes",
    "suffix": "+page.svelte"
  },
  "baselineDirectories": [
    "e2e/__screenshots__/iphone",
    "e2e/__screenshots__/desktop"
  ],
  "baselineTemplate": "e2e/__screenshots__/{project}/{snapshot}",
  "pages": [
    {
      "source": "src/routes/+page.svelte",
      "scenarios": ["reading"]
    },
    {
      "source": "src/routes/studio/+page.svelte",
      "scenarios": ["writing"]
    },
    {
      "source": "src/routes/[category]/+page.svelte",
      "scenarios": ["reading"]
    },
    {
      "source": "src/routes/tags/[tag]/+page.svelte",
      "exemption": "Tag archive reuses ArticleList covered by home/category screenshots; distinct tag filtering remains a documented coverage gap."
    },
    {
      "source": "src/routes/articles/[id]/+page.svelte",
      "scenarios": ["reading"]
    },
    {
      "source": "src/routes/[category]/[title]/+page.svelte",
      "scenarios": ["reading"]
    },
    {
      "source": "src/routes/auth/callback/+page.svelte",
      "exemption": "Auth0 callback requires real provider redirect and PKCE state; verified separately with production identity, not screenshot fixture."
    },
    {
      "source": "src/routes/studio/new/+page.svelte",
      "scenarios": ["writing"]
    },
    {
      "source": "src/routes/studio/[id]/+page.svelte",
      "scenarios": ["writing"]
    }
  ],
  "scenarios": [
    {
      "id": "reading",
      "kind": "screenshot",
      "evidence": [
        {
          "spec": "e2e/blog.spec.ts",
          "test": "SSR reading, canonical URLs, category, dark mode and empty/error states",
          "projects": ["iphone", "desktop"],
          "snapshots": [
            "home.png",
            "article.png",
            "article-dark.png",
            "category.png",
            "empty.png",
            "error.png"
          ]
        }
      ]
    },
    {
      "id": "writing",
      "kind": "screenshot",
      "evidence": [
        {
          "spec": "e2e/blog.spec.ts",
          "test": "editor saves Markdown and publishes through PostgREST",
          "projects": ["iphone", "desktop"],
          "snapshots": ["studio.png", "editor.png"]
        }
      ]
    }
  ]
}
