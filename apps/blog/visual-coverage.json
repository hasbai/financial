      "kind": "screenshot",
      "evidence": [
        {
          "spec": "e2e/blog.spec.ts",
          "test": "editor writes articles and titleless notes through Data API",
          "projects": [
            "iphone",
            "desktop"
          ],
          "snapshots": [
            "studio.png",
            "editor.png",
            "note-editor.png"
