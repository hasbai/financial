{
  "inventory": {
    "root": "src/routes",
    "suffix": "+page.svelte"
  },
  "baselineDirectories": [
    "e2e/__screenshots__/iphone",
    "e2e/__screenshots__/desktop"
  ],
  "baselineTemplate": "e2e/__screenshots__/{project}/{snapshot}",
  "pages": [
    { "source": "src/routes/+page.svelte", "scenarios": ["reading"] },
    { "source": "src/routes/articles/+page.svelte", "scenarios": ["reading"] },
    { "source": "src/routes/articles/[title]/+page.svelte", "scenarios": ["reading"] },
    { "source": "src/routes/notes/+page.svelte", "scenarios": ["reading"] },
    { "source": "src/routes/notes/[sequence=positiveInteger]/+page.svelte", "scenarios": ["reading"] },
    { "source": "src/routes/timeline/+page.svelte", "scenarios": ["reading"] },
    { "source": "src/routes/about/+page.svelte", "scenarios": ["reading"] },
    { "source": "src/routes/tags/[tag]/+page.svelte", "scenarios": ["reading"] },
    { "source": "src/routes/[category]/[title]/+page.svelte", "exemption": "Legacy category URLs issue a permanent redirect and have no rendered page; the redirect is asserted in the reading test." },
    { "source": "src/routes/contents/[id]/+page.svelte", "exemption": "The shared UUID entry redirects to its canonical article or note URL; the redirect is asserted in the reading test." },
    { "source": "src/routes/auth/callback/+page.svelte", "exemption": "Auth0 callback requires provider redirect and PKCE state; verified separately with production identity." },
    { "source": "src/routes/studio/+page.svelte", "scenarios": ["writing"] },
    { "source": "src/routes/studio/new/+page.svelte", "scenarios": ["writing"] },
    { "source": "src/routes/studio/[id]/+page.svelte", "scenarios": ["writing"] },
    { "source": "src/routes/studio/notes/new/+page.svelte", "scenarios": ["writing"] },
    { "source": "src/routes/studio/notes/[id]/+page.svelte", "scenarios": ["writing"] }
  ],
  "scenarios": [
    {
      "id": "reading",
      "kind": "screenshot",
      "evidence": [
        {
          "spec": "e2e/blog.spec.ts",
          "test": "SSR, direct Data API navigation, skeleton, canonical URLs and reading states",
          "projects": ["iphone", "desktop"],
          "snapshots": ["home.png", "articles.png", "article.png", "article-dark.png", "notes.png", "note.png", "timeline.png", "about.png", "tag.png", "empty.png", "error.png"]
        }
      ]
    },
    {
      "id": "writing",
      "kind": "screenshot",
      "evidence": [
        {
          "spec": "e2e/blog.spec.ts",
          "test": "editor writes articles and titleless notes through Data API",
          "projects": ["iphone", "desktop"],
          "snapshots": ["studio.png", "editor.png", "note-editor.png"]
        }
      ]
    }
  ]
}
