{
  "name": "blog",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 5174",
    "build": "vite build && node scripts/check-worker-startup.mjs",
    "typecheck": "wrangler types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots=all",
    "visual:local": "node ../../scripts/visual-linux.mjs blog",
    "preview": "vite preview --host 127.0.0.1 --port 4174",
    "visual:baseline:import": "node ../financial/scripts/visual-baselines.mjs import"
  },
  "dependencies": {
    "@hasbai/auth": "workspace:*",
    "@hasbai/data": "workspace:*",
    "@hasbai/markdown": "workspace:*",
    "@hasbai/ui": "workspace:*",
    "@lucide/svelte": "^1.45.0",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/markdown": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "svelte": "^5.57.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@sveltejs/adapter-cloudflare": "7.2.9",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.5.1",
    "shadcn-svelte": "^1.7.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "5.0.0",
    "workerd": "1.20261009.1",
    "wrangler": "^4.131.1",
    "yaml": "2.9.1"
  }
}
