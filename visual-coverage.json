  "inventory": {
    "root": "src/pages",
    "suffix": ".svelte"
  },
  "baselineTemplate": "e2e/__screenshots__/darwin-ci-{project}/{spec}/{snapshot}",
  "baselineDirectories": [
    "e2e/__screenshots__/darwin-ci-iphone",
    "e2e/__screenshots__/darwin-ci-iphone-se",
    "e2e/__screenshots__/darwin-ci-android",
    "e2e/__screenshots__/darwin-ci-desktop"
  ],
  "pages": [
    {
      "source": "src/pages/Overview.svelte",
      "scenarios": [
        "overview",
        "overview-loading",
        "overview-empty",
        "overview-error"
      ]
    },
    {
      "source": "src/pages/Transactions.svelte",
      "scenarios": [
        "transactions",
        "transactions-loading",
        "transactions-empty",
        "transactions-error"
      ]
    },
